# 복사해서 .env로 쓴다. 값은 커밋하지 않는다.

# 봇 ↔ 서버 검증용. 봇과 서버가 같은 값을 쓴다(필수).
BOT_SERVER_SECRET=

# Groq(선택). 없으면 요약·분류 없이 원문으로 답한다.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Cerebras(선택). 있으면 Groq 한도가 찼을 때 백그라운드 판정·추출을 같은 모델(gpt-oss-120b)로 넘긴다.
# 회의록이 Cerebras에도 전송된다. 무료 체험: 분당 5회, 하루 100만 토큰(결제 수단 등록 필요).
CEREBRAS_API_KEY=

# 로컬 Playground 테스트용. 실제 Teams 배포에서는 지운다.
DANGEROUSLY_ALLOW_UNAUTHENTICATED_REQUESTS=true

# 실제 Teams 배포용 자격증명(Playground에서는 주석 처리).
# CLIENT_ID=
# CLIENT_SECRET=
# TENANT_ID=

# 개발용 번호 대체(Playground 사용자는 표시 이름에 번호가 없다). 개발 PC에서만.
# SEAM_ENV=development 가 아니거나 CLIENT_ID 등이 있으면 서버가 시작하지 않는다. 번호는 src/roster.playground.json에 있는 것만.
# SEAM_ENV=development
# SEAM_DEV_MEMBER_NO=
